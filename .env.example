# Postgres connection string
DATABASE_URL=postgres://postgres@localhost:5432/linkup

# Google Places API (New). Without it, LinkUp uses demo restaurants.
# Enable "Places API (New)" in Google Cloud and create a key.
GOOGLE_PLACES_API_KEY=

# Port for the combined Next.js + WebSocket server
PORT=3000

# Claude API key for AI features (reading what people are in the mood for).
# Without it, LinkUp falls back to simple keyword matching.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model parses wishes (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=
# Optional: which Claude model picks the deck (default: same as above). A bigger model may choose better but is slower.
# ANTHROPIC_CURATE_MODEL=
