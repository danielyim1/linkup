{
  "name": "linkup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --clear-screen=false server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "eval:prefs": "tsx --env-file-if-exists=.env scripts/eval-preferences.ts",
    "rank:demo": "tsx --env-file-if-exists=.env scripts/rank-demo.ts",
    "mcp:db": "tsx --env-file-if-exists=.env mcp/linkup-db.ts",
    "check": "bash .claude/skills/check-everything/scripts/check.sh",
    "eval:deck": "tsx --env-file-if-exists=.env scripts/eval-deck.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
